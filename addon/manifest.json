{
  "manifest_version": 2,
  "name": "Thunderbird MCP Bridge",
  "version": "0.2.0",
  "description": "Local bridge that lets Claude read, search, draft, send, and organize Thunderbird messages through MCP.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-mcp@local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "persistent": true
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "message_display_action": {
    "default_title": "Thunderbird MCP",
    "default_icon": "icons/icon.svg"
  },
  "compose_action": {
    "default_title": "Thunderbird MCP",
    "default_icon": "icons/icon.svg"
  },
  "permissions": [
    "messagesRead",
    "messagesUpdate",
    "messagesMove",
    "messagesDelete",
    "accountsRead",
    "compose",
    "compose.save",
    "compose.send",
    "nativeMessaging",
    "storage"
  ]
}
